{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/diagnostic.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/diagnostic",
      "dest": "/api/diagnostic.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}