{
  "name": "ruangtoko/store",
  "type": "project",
  "description": "Toko online, inventori dan berita berbahasa Indonesia",
  "require": {"php": "^8.3", "laravel/framework": "^13.0"},
  "require-dev": {"phpunit/phpunit": "^12.0", "mockery/mockery": "^1.6", "fakerphp/faker": "^1.24"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php vendor/phpunit/phpunit/phpunit"},
  "config": {"sort-packages": true, "preferred-install": "dist", "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
